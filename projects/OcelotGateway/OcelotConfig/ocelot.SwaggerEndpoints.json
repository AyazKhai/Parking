{
  "SwaggerEndPoints": [
    {
      "Key": "auth",
      "Config": [
        {
          "Name": "Identity Service API",
          "Version": "v1",
          "Service": {
            "Name": "auth",
            "Path": "/swagger/v1/swagger.json"
          }
        }
      ]
    },
    {
      "Key": "booking",
      "Config": [
        {
          "Name": "Booking Service API",
          "Version": "v1",
          "Service": {
            "Name": "booking",
            "Path": "/swagger/v1/swagger.json"
          }
        }
      ]
    },
    {
      "Key": "parking",
      "Config": [
        {
          "Name": "Parking Service API",
          "Version": "v1",
          "Service": {
            "Name": "parking",
            "Path": "/swagger/v1/swagger.json"
          }
        }
      ]
    }
  ],
  "RouteOptions": {
    "ExcludeRoutes": [ "/auth/login" ],
    "UseCookieAuthorization": true
  }
}