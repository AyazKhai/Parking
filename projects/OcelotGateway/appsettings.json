{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Trace",
      "Ocelot": "Trace"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "auth": {
      "DownstreamPath": "http://localhost:7000"
    },
    "booking": {
      "DownstreamPath": "http://localhost:6000"
    },
    "parking": {
      "DownstreamPath": "http://localhost:5000"
    }
  },
  "CookieAuthentication": {
    "Name": "identity.auth",
    "Domain": "localhost",
    "SlidingExpiration": true,
    "ExpireTimeSpan": "10.00:00:00"
  }
}
