@page "/parkings/create"
@model Parking.Frontend.Pages.Parkings.CreateParkingModel
@{
}

<h2>Input data for new Paking</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<form method="post">
    <div class="form-group">
        <label asp-for="createPark.address"></label>
        <input asp-for="createPark.address" class="form-control" />
        <span asp-validation-for="createPark.address" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="createPark.information"></label>
        <input asp-for="createPark.information" class="form-control" />
        <span asp-validation-for="createPark.information" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input type="checkbox" asp-for="createPark.isAvailable" class="form-check-input" />
        <label asp-for="createPark.isAvailable" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="/Parkings/Index" class="btn btn-secondary">Cancel</a>
</form>